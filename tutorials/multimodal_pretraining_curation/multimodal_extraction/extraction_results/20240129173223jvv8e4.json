{"source_filename": "/raid/home/ruchaa/projects/Curator/tutorials/multimodal_pretraining_curation/source/20240129173223jvv8e4.pdf", "pages": [{"page_number": 1, "status": "Layout extraction successful", "content": [{"extraction_id": 0, "metadata": {"source_page": 1, "type": "Page-header", "bbox": {"xmin": 0.05539418457648546, "ymin": 0.0289, "xmax": 0.1327939317319848, "ymax": 0.0461}}, "data": {"type": "textual", "content": "Datasheet"}}, {"extraction_id": 1, "metadata": {"source_page": 1, "type": "Section-header", "bbox": {"xmin": 0.0534149178255373, "ymin": 0.1469, "xmax": 0.49489557522123895, "ymax": 0.175}}, "data": {"type": "textual", "content": "ConnectX-7 400G Adapters"}}, {"extraction_id": 2, "metadata": {"source_page": 1, "type": "Text", "bbox": {"xmin": 0.05643590391908976, "ymin": 0.1773, "xmax": 0.4705193426042984, "ymax": 0.2172}}, "data": {"type": "textual", "content": "Smart, Accelerated Networking for Modern Data Center Infrastructure"}}, {"extraction_id": 3, "metadata": {"source_page": 1, "type": "Text", "bbox": {"xmin": 0.05445663716814159, "ymin": 0.2664, "xmax": 0.6372986093552465, "ymax": 0.3477}}, "data": {"type": "textual", "content": "The NVIDIA\u00ae ConnectX\u00ae-7 family of Remote Direct Memory Access (RDMA) network adapters supports InfiniBand and Ethernet protocols and a range of speeds up to 400Gb/s. It enables a wide range of smart, scalable, and feature-rich networking solutions that address traditional enterprise needs up to the world\u2019s most-demanding AI, scientific computing, and hyperscale cloud data center workloads."}}, {"extraction_id": 4, "metadata": {"source_page": 1, "type": "Section-header", "bbox": {"xmin": 0.05539418457648546, "ymin": 0.3609, "xmax": 0.3911403286978508, "ymax": 0.3797}}, "data": {"type": "textual", "content": "Accelerated Networking and Security"}}, {"extraction_id": 5, "metadata": {"source_page": 1, "type": "Text", "bbox": {"xmin": 0.05539418457648546, "ymin": 0.3844, "xmax": 0.6067762326169406, "ymax": 0.4633}}, "data": {"type": "textual", "content": "ConnectX-7 provides a broad set of software-defined, hardware-accelerated networking, storage, and security capabilities which enable organizations to modernize and secure their IT infrastructures. Moreover, ConnectX-7 empowers agile and high-performance solutions from edge to core data centers to clouds, all while enhancing network security and reducing the total cost of ownership. "}}, {"extraction_id": 6, "metadata": {"source_page": 1, "type": "Section-header", "bbox": {"xmin": 0.0534149178255373, "ymin": 0.4773, "xmax": 0.4572895069532238, "ymax": 0.4961}}, "data": {"type": "textual", "content": "Accelerate Data-Driven Scientific Computing"}}, {"extraction_id": 7, "metadata": {"source_page": 1, "type": "Text", "bbox": {"xmin": 0.05539418457648546, "ymin": 0.5008, "xmax": 0.6271939317319849, "ymax": 0.5516}}, "data": {"type": "textual", "content": "ConnectX-7 provides ultra-low latency, extreme throughput, and innovative NVIDIA In-Network Computing engines to deliver the acceleration, scalability, and featurerich technology needed for today\u2019s modern scientific computing workloads. "}}, {"extraction_id": 8, "metadata": {"source_page": 1, "type": "Section-header", "bbox": {"xmin": 0.05539418457648546, "ymin": 0.5656, "xmax": 0.14696131479140329, "ymax": 0.5828}}, "data": {"type": "textual", "content": "Features*"}}, {"extraction_id": 9, "metadata": {"source_page": 1, "type": "Section-header", "bbox": {"xmin": 0.05539418457648546, "ymin": 0.5891, "xmax": 0.20092237673830593, "ymax": 0.6023}}, "data": {"type": "textual", "content": "InfiniBand Interface"}}, {"extraction_id": 10, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.6062, "xmax": 0.3270745891276865, "ymax": 0.6344}}, "data": {"type": "textual", "content": "> InfiniBand Trade Association Spec 1.5 compliant"}}, {"extraction_id": 11, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.6359, "xmax": 0.2853016434892541, "ymax": 0.6492}}, "data": {"type": "textual", "content": "> RDMA, send/receive semantics"}}, {"extraction_id": 12, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.6516, "xmax": 0.3209284450063211, "ymax": 0.6641}}, "data": {"type": "textual", "content": "> 16 million input/output (IO) channels"}}, {"extraction_id": 13, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.6664, "xmax": 0.3311372945638432, "ymax": 0.6953}}, "data": {"type": "textual", "content": "> 256 to 4Kbyte maximum transmission unit (MTU), 2Gbyte messages"}}, {"extraction_id": 14, "metadata": {"source_page": 1, "type": "Section-header", "bbox": {"xmin": 0.05747762326169406, "ymin": 0.7016, "xmax": 0.18967180783817955, "ymax": 0.7148}}, "data": {"type": "textual", "content": "Ethernet Interface"}}, {"extraction_id": 15, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.7203, "xmax": 0.3300955752212389, "ymax": 0.7633}}, "data": {"type": "textual", "content": "> Up to 4 network ports supporting NRZ, PAM4 (50G and 100G), in various configurations"}}, {"extraction_id": 16, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.7648, "xmax": 0.2833223767383059, "ymax": 0.7789}}, "data": {"type": "textual", "content": "> Up to 400Gb/s total bandwidth"}}, {"extraction_id": 17, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.7812, "xmax": 0.3352, "ymax": 0.7945}}, "data": {"type": "textual", "content": "> RDMA over Converged Ethernet (RoCE)"}}, {"extraction_id": 18, "metadata": {"source_page": 1, "type": "Section-header", "bbox": {"xmin": 0.05643590391908976, "ymin": 0.8008, "xmax": 0.28436409608091023, "ymax": 0.8148}}, "data": {"type": "textual", "content": "Enhanced InfiniBand Networking"}}, {"extraction_id": 19, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.8187, "xmax": 0.30676106194690267, "ymax": 0.8305}}, "data": {"type": "textual", "content": "> Hardware-based reliable transport"}}, {"extraction_id": 20, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.8328, "xmax": 0.31082376738305945, "ymax": 0.8461}}, "data": {"type": "textual", "content": "Extended Reliable Connected (XRC)"}}, {"extraction_id": 21, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.85, "xmax": 0.30259418457648546, "ymax": 0.8828}}, "data": {"type": "textual", "content": "> Dynamically Connected Transport (DCT)"}}, {"extraction_id": 22, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.8867, "xmax": 0.19988065739570166, "ymax": 0.8984}}, "data": {"type": "textual", "content": "> GPDirectTM RDMA"}}, {"extraction_id": 23, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.058519342604298356, "ymin": 0.9023, "xmax": 0.2039433628318584, "ymax": 0.9156}}, "data": {"type": "textual", "content": "> GPDirect Storage"}}, {"extraction_id": 24, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.3616596713021492, "ymin": 0.5898, "xmax": 0.546773198482933, "ymax": 0.6016}}, "data": {"type": "textual", "content": "> Adaptive routing support"}}, {"extraction_id": 25, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.3616596713021492, "ymin": 0.6047, "xmax": 0.5681284450063212, "ymax": 0.6164}}, "data": {"type": "textual", "content": "> Enhanced atomic operations"}}, {"extraction_id": 26, "metadata": {"source_page": 1, "type": "List-item", "bbox": {"xmin": 0.3616596713021492, "ymin": 0.6195, "xmax": 0.6240687737041719, "ymax": 0.6469}}, "data": {"type": "textual", "content": "> Advanced memory mapping, allowing user mode re